# ===========================================
# VARIABLES D'ENVIRONNEMENT - WORDCRAFT IA
# ===========================================
# Copiez ce fichier en .env.local et .env.production
# Ne jamais commiter les vraies variables d'environnement !

# ===========================================
# CONFIGURATION SUPABASE
# ===========================================
# URL de votre projet Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clé anonyme Supabase (côté client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clé service Supabase (côté serveur)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# CONFIGURATION OPENAI
# ===========================================
# Clé API OpenAI pour les fonctionnalités IA
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# Organisation OpenAI (optionnel)
VITE_OPENAI_ORG_ID=org-your-org-id-here

# Modèle OpenAI par défaut
VITE_OPENAI_MODEL=gpt-4-turbo-preview

# ===========================================
# CONFIGURATION DAILY.CO (VIDÉO)
# ===========================================
# Clé API Daily.co pour les sessions vidéo
VITE_DAILY_API_KEY=your-daily-api-key-here

# URL de base Daily.co
VITE_DAILY_BASE_URL=https://api.daily.co/v1

# ===========================================
# CONFIGURATION EMAIL
# ===========================================
# Service d'envoi d'emails (brevo, sendgrid, etc.)
VITE_EMAIL_SERVICE=brevo

# Clé API du service email
VITE_EMAIL_API_KEY=your-email-service-api-key-here

# Email expéditeur par défaut
VITE_FROM_EMAIL=noreply@wordcraft.ai

# Nom de l'application pour les emails
VITE_APP_NAME=WordCraft IA

# ===========================================
# CONFIGURATION STOCKAGE
# ===========================================
# URL du bucket Supabase Storage
VITE_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# Taille maximale des fichiers (en octets)
VITE_MAX_FILE_SIZE=52428800

# Types de fichiers autorisés
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif

# ===========================================
# CONFIGURATION PAIEMENT
# ===========================================
# Clé API Moov Money (pour les paiements)
VITE_MOOV_MONEY_API_KEY=your-moov-money-api-key-here

# URL de callback Moov Money
VITE_MOOV_MONEY_CALLBACK_URL=https://your-domain.com/payment/callback

# ===========================================
# CONFIGURATION ANALYTICS
# ===========================================
# Clé Google Analytics (optionnel)
VITE_GA_TRACKING_ID=GA-XXXXXXXXX

# Clé PostHog (optionnel)
VITE_POSTHOG_KEY=phc_your-posthog-key-here

# URL PostHog
VITE_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# CONFIGURATION SENTRY (ERROR TRACKING)
# ===========================================
# DSN Sentry pour le tracking d'erreurs
VITE_SENTRY_DSN=https://your-sentry-dsn-here

# Environnement Sentry
VITE_SENTRY_ENVIRONMENT=production

# ===========================================
# CONFIGURATION DÉVELOPPEMENT
# ===========================================
# Mode debug (true/false)
VITE_DEBUG=false

# Port de développement
VITE_DEV_PORT=3000

# URL de l'application en développement
VITE_DEV_URL=http://localhost:3000

# URL de l'application en production
VITE_PROD_URL=https://wordcraft.ai

# ===========================================
# CONFIGURATION SÉCURITÉ
# ===========================================
# Secret pour les tokens JWT
VITE_JWT_SECRET=your-super-secret-jwt-key-here

# Clé de chiffrement pour les données sensibles
VITE_ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# CONFIGURATION PERFORMANCE
# ===========================================
# Timeout des requêtes API (en millisecondes)
VITE_API_TIMEOUT=30000

# Nombre maximum de tentatives de requêtes
VITE_MAX_RETRIES=3

# ===========================================
# CONFIGURATION FEATURE FLAGS
# ===========================================
# Activer les fonctionnalités expérimentales
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Activer le mode maintenance
VITE_MAINTENANCE_MODE=false

# ===========================================
# CONFIGURATION RÉSEAU
# ===========================================
# URL de l'API backend
VITE_API_URL=https://api.wordcraft.ai

# WebSocket URL pour le temps réel
VITE_WS_URL=wss://api.wordcraft.ai/ws

# ===========================================
# CONFIGURATION CDN
# ===========================================
# URL du CDN pour les assets statiques
VITE_CDN_URL=https://cdn.wordcraft.ai

# ===========================================
# NOTES IMPORTANTES
# ===========================================
# 1. Ne jamais commiter ce fichier avec des vraies clés
# 2. Utilisez .env.local pour le développement
# 3. Utilisez .env.production pour la production
# 4. Ajoutez .env* à .gitignore
# 5. Utilisez des clés différentes pour dev/prod
# 6. Faites tourner les clés régulièrement
